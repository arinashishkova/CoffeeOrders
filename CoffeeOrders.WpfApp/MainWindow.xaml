<Window x:Class="CoffeeOrders.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Coffee Orders"
        Height="620"
        Width="950"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/coffee.ico">

    <Window.Resources>

        <!-- Rounded button style -->
        <Style x:Key="CoffeeButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#745A43"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded TextBox -->
        <Style x:Key="CoffeeTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFDF9"/>
            <Setter Property="BorderBrush" Value="#CBBBAA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

    </Window.Resources>

    <Grid>

        <!-- Background photo -->
        <Grid.Background>
            <ImageBrush ImageSource="Assets/coffee_background.jpg"
                        Stretch="UniformToFill"
                        AlignmentX="Center"
                        AlignmentY="Center"/>
        </Grid.Background>

        <!-- Slight overlay -->
        <Border Background="#33FFFFFF"/>

        <!-- Main card -->
        <Border Margin="35"
                Padding="28"
                CornerRadius="18"
                Background="#EAF8F4ED">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title -->
                <StackPanel Grid.Row="0"
                            Margin="0,0,0,22">

                    <TextBlock Text="Coffee Orders"
                               FontFamily="Georgia"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#4A3828"/>

                    <TextBlock Text="Manage orders"
                               FontSize="13"
                               Foreground="#786A5D"
                               Margin="2,4,0,0"/>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            Margin="0,0,0,18">

                    <Button x:Name="AddButton"
                            Content="Add"
                            Width="95"
                            Height="38"
                            Margin="0,0,10,0"
                            Style="{StaticResource CoffeeButtonStyle}"
                            Click="AddButton_Click"/>

                    <Button x:Name="EditButton"
                            Content="Edit"
                            Width="95"
                            Height="38"
                            Margin="0,0,10,0"
                            Style="{StaticResource CoffeeButtonStyle}"
                            Click="EditButton_Click"/>

                    <Button x:Name="DeleteButton"
                            Content="Delete"
                            Width="95"
                            Height="38"
                            Style="{StaticResource CoffeeButtonStyle}"
                            Click="DeleteButton_Click"/>
                </StackPanel>

                <!-- Search -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            Margin="0,0,0,18">

                    <TextBlock Text="Search customer:"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="#4A3828"
                               Margin="0,0,10,0"/>

                    <TextBox x:Name="SearchTextBox"
                             Width="260"
                             Height="34"
                             Style="{StaticResource CoffeeTextBoxStyle}"
                             TextChanged="SearchTextBox_TextChanged"/>
                </StackPanel>

                <!-- DataGrid card -->
                <Border Grid.Row="3"
                        Background="#F8FFFFFF"
                        CornerRadius="12"
                        BorderBrush="#D9CFC3"
                        BorderThickness="1"
                        Padding="6">

                    <DataGrid x:Name="OrdersDataGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              BorderThickness="0"
                              Background="Transparent"
                              RowBackground="#00FFFFFF"
                              AlternatingRowBackground="#22DCCFBE"
                              FontSize="13">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Customer"
                                                Binding="{Binding CustomerName}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Drink"
                                                Binding="{Binding DrinkType}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Size"
                                                Binding="{Binding DrinkSize}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Quantity"
                                                Binding="{Binding Quantity}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Price"
                                                Binding="{Binding Price}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Time"
                                                Binding="{Binding PreparationTime}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding Status}"
                                                Width="*"/>

                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Summary -->
                <Border Grid.Row="4"
                        Background="#DDF4EEE7"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,18,0,0">

                    <TextBlock x:Name="SummaryTextBlock"
                               Text="Orders: 0 | Total: €0.00"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#4A3828"/>
                </Border>

            </Grid>
        </Border>
    </Grid>
</Window>
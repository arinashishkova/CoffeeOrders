<Window x:Class="CoffeeOrders.WpfApp.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Coffee Order"
        Height="520"
        Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F4EEE7"
        Icon="Assets/coffee.ico">

    <Window.Resources>

        <!-- Button style -->
        <Style x:Key="CoffeeButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#745A43"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="28">

        <!-- Main card -->
        <Border Background="#FFFDF9"
                CornerRadius="18"
                Padding="26"
                BorderBrush="#DED2C5"
                BorderThickness="1">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="115"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title -->
                <StackPanel Grid.Row="0"
                            Grid.ColumnSpan="2"
                            Margin="0,0,0,24">

                    <TextBlock x:Name="OrderTitleTextBlock"
                               Text="New Coffee Order"
                               FontFamily="Georgia"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#4A3828"/>

                    <TextBlock Text="Enter the order details below"
                               FontSize="12"
                               Foreground="#85766A"
                               Margin="1,4,0,0"/>
                </StackPanel>

                <!-- Customer -->
                <TextBlock Grid.Row="1"
                           Text="Customer:"
                           VerticalAlignment="Center"
                           Foreground="#4A3828"
                           Margin="0,0,10,14"/>

                <Border Grid.Row="1"
                        Grid.Column="1"
                        CornerRadius="7"
                        BorderBrush="#CBBBAA"
                        BorderThickness="1"
                        Background="White"
                        Margin="0,0,0,14">

                    <TextBox x:Name="CustomerNameTextBox"
                             Height="32"
                             Padding="8,5"
                             BorderThickness="0"
                             Background="Transparent"/>
                </Border>

                <!-- Drink -->
                <TextBlock Grid.Row="2"
                           Text="Drink:"
                           VerticalAlignment="Center"
                           Foreground="#4A3828"
                           Margin="0,0,10,14"/>

                <Border Grid.Row="2"
                        Grid.Column="1"
                        CornerRadius="7"
                        BorderBrush="#CBBBAA"
                        BorderThickness="1"
                        Background="White"
                        Margin="0,0,0,14">

                    <ComboBox x:Name="DrinkTypeComboBox"
                              Height="32"
                              BorderThickness="0"
                              Background="Transparent"/>
                </Border>

                <!-- Size -->
                <TextBlock Grid.Row="3"
                           Text="Size:"
                           VerticalAlignment="Center"
                           Foreground="#4A3828"
                           Margin="0,0,10,14"/>

                <Border Grid.Row="3"
                        Grid.Column="1"
                        CornerRadius="7"
                        BorderBrush="#CBBBAA"
                        BorderThickness="1"
                        Background="White"
                        Margin="0,0,0,14">

                    <ComboBox x:Name="DrinkSizeComboBox"
                              Height="32"
                              BorderThickness="0"
                              Background="Transparent"/>
                </Border>

                <!-- Quantity -->
                <TextBlock Grid.Row="4"
                           Text="Quantity:"
                           VerticalAlignment="Center"
                           Foreground="#4A3828"
                           Margin="0,0,10,14"/>

                <Border Grid.Row="4"
                        Grid.Column="1"
                        CornerRadius="7"
                        BorderBrush="#CBBBAA"
                        BorderThickness="1"
                        Background="White"
                        Margin="0,0,0,14">

                    <TextBox x:Name="QuantityTextBox"
                             Height="32"
                             Text="1"
                             Padding="8,5"
                             BorderThickness="0"
                             Background="Transparent"/>
                </Border>

                <!-- Status -->
                <TextBlock Grid.Row="5"
                           Text="Status:"
                           VerticalAlignment="Center"
                           Foreground="#4A3828"
                           Margin="0,0,10,14"/>

                <Border Grid.Row="5"
                        Grid.Column="1"
                        CornerRadius="7"
                        BorderBrush="#CBBBAA"
                        BorderThickness="1"
                        Background="White"
                        Margin="0,0,0,14">

                    <ComboBox x:Name="StatusComboBox"
                              Height="32"
                              BorderThickness="0"
                              Background="Transparent"/>
                </Border>

                <!-- Buttons -->
                <StackPanel Grid.Row="6"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,12,0,0">

                    <Button x:Name="SaveButton"
                            Content="Save"
                            Width="95"
                            Height="38"
                            Margin="0,0,10,0"
                            Style="{StaticResource CoffeeButtonStyle}"
                            Click="SaveButton_Click"/>

                    <Button Content="Cancel"
                            Width="95"
                            Height="38"
                            Background="#9A8A7A"
                            Style="{StaticResource CoffeeButtonStyle}"
                            Click="CancelButton_Click"/>

                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</Window>